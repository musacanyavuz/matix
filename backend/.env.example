# ===========================================
# Matix Backend - Ortam Değişkenleri
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# Sunucu
PORT=3001
NODE_ENV=development

# CORS - İzin verilen origin'ler (virgülle ayırın, * = tümü)
CORS_ORIGIN=*

# JWT Kimlik Doğrulama (PRODUCTION'DA MUTLAKA DEĞİŞTİRİN!)
JWT_SECRET=matix-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting (opsiyonel)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Firebase Firestore (ZORUNLU)
# Firebase Console'dan Service Account JSON indirin
FIREBASE_PROJECT_ID=your-firebase-project-id

# Seçenek 1: Dosya yolu ile
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Seçenek 2: JSON string olarak (CI/CD için)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
